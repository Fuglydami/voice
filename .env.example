# ---------------------------------------------------------------------------
# VOICE environment
#
# Copy to `.env.local` for local development, or `.env` for docker compose:
#   cp .env.example .env.local
#
# Each key below is individually optional: a provider without one is skipped
# rather than failed, so the app works with one or two configured. At least one
# is needed for the app to have anything to show.
#
# No key uses the NEXT_PUBLIC_ prefix: they are read only in src/lib/env.ts,
# which is marked `server-only` and can never reach the browser bundle.
# ---------------------------------------------------------------------------

# https://newsapi.org/register
# The free Developer plan restricts *browser* requests to a localhost origin.
# That is a CORS rule and does not apply here — this app calls NewsAPI from the
# server — but the plan is still meant for development rather than production.
NEWSAPI_KEY=

# https://open-platform.theguardian.com/access
GUARDIAN_KEY=

# https://developer.nytimes.com  (create an app, enable "Article Search API")
NYT_KEY=

# ---------------------------------------------------------------------------
# Tuning (optional — sensible defaults are built in)
# ---------------------------------------------------------------------------

# Per-provider upstream timeout. One slow source cannot stall the page.
PROVIDER_TIMEOUT_MS=10000

# How long normalised provider responses stay fresh, in seconds. Raising this
# reduces upstream calls and helps stay inside the free-tier rate limits.
PROVIDER_CACHE_SECONDS=300
